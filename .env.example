APP_NAME=MY-AI
ENVIRONMENT=production
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./my_ai.db

# ---------------------------------------------------------------------------
# Telegram Cloud Database (bot + private channel)
# 1) Create a bot with @BotFather  -> copy the token below
# 2) Create a private channel       -> add the bot as ADMIN (Post Messages ON)
# 3) Paste the channel id here      -> (like -1001234567890 or @yourchannel)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=

API_SECRET=
ENCRYPTION_KEY=
ALLOWED_ORIGINS=*
ADMIN_EMAIL=
MODEL_PATH=
ACTIVE_MODEL=BasicEngine
BACKUP_ENABLED=true
RESEARCH_ENABLED=true
MEMORY_ENABLED=true
RAG_ENABLED=true
