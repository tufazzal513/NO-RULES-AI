APP_NAME=MY-AI
ENVIRONMENT=production
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./my_ai.db

# ---------------------------------------------------------------------------
# Telegram Cloud Database (bot + private channel)
# 1) Create a bot with @BotFather  -> copy the token below
# 2) Create a private channel       -> add the bot as ADMIN (Post Messages ON)
# 3) Paste the channel id here      -> (like -1001234567890 or @yourchannel)
#
# The SAME bot also works as your AI assistant: message it in Telegram
# (from your phone) and it replies using your own AI brain. Long-polling,
# so no webhook URL is needed — it works on Render out of the box.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=

# ---------------------------------------------------------------------------
# Telegram as the PERMANENT database (Render Free has an ephemeral disk)
#
#   TELEGRAM_AUTO_RESTORE            on startup, pull the latest snapshot back
#   TELEGRAM_RESTORE_ON_EMPTY_ONLY   only restore when the local DB is empty
#                                    (protects existing local data)
#   TELEGRAM_AUTO_SNAPSHOT           upload a full snapshot on a timer
#   TELEGRAM_SNAPSHOT_INTERVAL_MINUTES  how often (minutes)
# ---------------------------------------------------------------------------
TELEGRAM_AUTO_RESTORE=true
TELEGRAM_AUTO_SNAPSHOT=true
TELEGRAM_SNAPSHOT_INTERVAL_MINUTES=30
TELEGRAM_RESTORE_ON_EMPTY_ONLY=true

# ---------------------------------------------------------------------------
# Online research — 17 free keyless sources (English + Bengali Wikipedia,
# DuckDuckGo, 8 rotating SearXNG instances, Mojeek, Wiktionary, Marginalia).
# No API key, no signup. All of these are OPTIONAL and non-secret;
# every one has a safe default and can be omitted entirely.
#
#   RESEARCH_ENABLED               allow online research in chat (true/false)
#   RESEARCH_CACHE_TTL_MINUTES     how long a cached finding stays fresh
#   RESEARCH_TIMEOUT_MS            hard time budget for one research call
#                                  (chat latency never exceeds this)
#   RESEARCH_SAVE_TO_KNOWLEDGE     save findings as knowledge documents so
#                                  they survive restarts and can be answered
#                                  later even without internet
#   RESEARCH_MAX_ATTEMPTS          max sources touched by ONE question (8)
#   RESEARCH_MAX_REQUESTS_PER_MINUTE  global cap — automatic lookups can
#                                  never hammer the sources into blocking
# ---------------------------------------------------------------------------
RESEARCH_ENABLED=true
RESEARCH_CACHE_TTL_MINUTES=360
RESEARCH_TIMEOUT_MS=4000
RESEARCH_SAVE_TO_KNOWLEDGE=true
RESEARCH_MAX_ATTEMPTS=8
RESEARCH_MAX_REQUESTS_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Admin password (OPTIONAL). When set, the Training page and every write
# action (train model, knowledge, memory, users, restore, research reset…)
# require this password from the web UI (x-admin-token header). When left
# empty, the panel behaves as a single-user admin panel. It is a server-side
# config value — never store it in Git, set it in Render as a secret.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

API_SECRET=
ENCRYPTION_KEY=
ALLOWED_ORIGINS=*
ADMIN_EMAIL=
MODEL_PATH=
ACTIVE_MODEL=BasicEngine
BACKUP_ENABLED=true
RESEARCH_ENABLED=true
MEMORY_ENABLED=true
RAG_ENABLED=true
